l = [(3,5), (1,3), (2,4)]
# 何らかの処理を行って [(1,3), (2,4), (3,5)] を得たい
def cmp(x,y):
    # x,y : 長さ2のタプル -> 書きやすさのためアンパックしておく
    a,b = x
    c,d = y
    if a*d < b*c:
        return -1
    elif a*d == b*c:
        return 0
    else: 
        return 1
from functools import cmp_to_key
l.sort(key = cmp_to_key(cmp)) # ↑で定義した cmp 関数を cmp_to_key 関数に与える
print(l) # [(1, 3), (2, 4), (3, 5)]

# -1が先、1が後