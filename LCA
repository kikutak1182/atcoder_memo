class LCA:
    def __init__(self, node, root=0):
        self.node = node
        self.root = root
        self.N = len(node)
        self.logn = (self.N - 1).bit_length()
        self.depth = [-1 if i != root else 0 for i in range(self.N)]
        self.parent = [[-1] * self.N for _ in range(self.logn)]
        self.dfs()
        self.doubling()

    def dfs(self):
        que = [self.root]
        while que:
            u = que.pop()
            for v in self.node[u]:
                if self.depth[v] == -1:
                    self.depth[v] = self.depth[u] + 1
                    self.parent[0][v] = u
                    que.append(v)

    def doubling(self):
        for i in range(1, self.logn):
            for v in range(self.N):
                p = self.parent[i - 1][v]
                if p != -1:
                    self.parent[i][v] = self.parent[i - 1][p]

    def get(self, u, v): # u,vの最長共通祖先を返す
        if self.depth[v] < self.depth[u]:
            u, v = v, u
        du = self.depth[u]
        dv = self.depth[v]

        d = dv - du
        for i in range(self.logn):
            if (d >> i) & 1:
                v = self.parent[i][v]

        if u == v:
            return u

        for i in range(self.logn - 1, -1, -1):
            pu, pv = self.parent[i][u], self.parent[i][v]
            if pu != pv:
                u, v = pu, pv

        return self.parent[0][u]

    def dist(self, x, y):
        """木の辺数距離（x と y の最短距離）を返す: O(log N)"""
        p = self.get(x, y)
        return self.depth[x] + self.depth[y] - 2 * self.depth[p]
