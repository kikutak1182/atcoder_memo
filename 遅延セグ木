#6区間変更・区間和取得
# 値 S = (sum, len), 作用 F = assign_value or None
# 区間代入を1個のlazy作用として書きたいから、各ノードは「区間の和」と「区間の長さ」を持つ必要がある
ID = None
def op(a, b):
    return (a[0] + b[0], a[1] + b[1])
def mapping(f, a):
    if f is ID:          # 無操作
        return a
    else:                # 代入：全要素を f に
        return (f * a[1], a[1])
def composition(f_upper, f_lower):
    # 上位の代入があればそれが勝つ（より新しい命令を優先）
    return f_lower if f_upper is ID else f_upper
e = (0, 0)
id_ = ID
V = [(x, 1) for x in A]
seg = LazySegTree(op, e, mapping, composition, id_, V)


