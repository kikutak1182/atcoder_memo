# 任意 mod で C(N, k) を求めるライブラリ（N固定）
# 計算量: O(NlogM/loglogM)  (ただしM=mod)
# https://qiita.com/suisen_cp/items/d0ab7e728b98bbec818f をベースに改変

# 使い方:
#   comb = ArbitraryModCombination(N, MOD)
#   comb[k]          # C(N, k) % MOD、範囲外だと0を返す
#   comb.C            # [C(n,0), C(n,1), ..., C(n,n)]
#
# 注意:
#   固定した N に対して、すべての k の C(N,k) を前計算する。


class ArbitraryModCombination:
    def __init__(self, n, mod):
        self.n = n
        self.mod = mod
        self.C = [0] * (n + 1)
        self._build()

    def __getitem__(self, k):
        if k < 0 or k > self.n:
            return 0
        return self.C[k]

    def _linear_sieve(self, n):
        lp = [0] * (n + 1)
        primes = []
        for x in range(2, n + 1):
            if lp[x] == 0:
                lp[x] = x
                primes.append(x)
            for p in primes:
                if p > lp[x] or x * p > n:
                    break
                lp[x * p] = p
        return lp, primes

    def _inv(self, a):
        mod = self.mod
        b = mod
        u, v = 1, 0
        while b:
            q = a // b
            a, b = b, a - q * b
            u, v = v, u - q * v
        return u % mod

    def _build(self):
        n = self.n
        mod = self.mod
        if mod == 1:return
        lp, primes = self._linear_sieve(n)
        d = [0] * (n + 1)
        p = [0]
        for q in primes:
            if mod % q == 0:
                p.append(q)
                idx = len(p) - 1
                for v in range(q, n + 1, q):
                    d[v] = idx
        L = len(p) - 1
        invs = [0] * (n + 1)
        if n >= 1:
            invs[1] = 1

        for x in range(2, n + 1):
            q = lp[x]
            if q == x:
                if mod % q != 0:
                    invs[x] = self._inv(x)
            else:
                invs[x] = invs[q] * invs[x // q] % mod
        powers = [[] for _ in range(L + 1)]
        for i in range(1, L + 1):
            q = p[i]
            mx = n // (q - 1)
            powers[i] = [1] * (mx + 1)
            for e in range(mx):
                powers[i][e + 1] = powers[i][e] * q % mod
        self.C[0] = 1 % mod
        S = 1 % mod
        T = [0] * (L + 1)
        half = n // 2
        for k in range(1, half + 1):
            num = n - k + 1
            den = k
            while num > 1 and d[num]:
                i = d[num]
                T[i] += 1
                num //= p[i]
            while den > 1 and d[den]:
                i = d[den]
                T[i] -= 1
                den //= p[i]
            S = S * (num % mod) % mod
            S = S * invs[den] % mod

            val = S
            for i in range(1, L + 1):
                val = val * powers[i][T[i]] % mod
            self.C[k] = val

        for k in range(half + 1, n + 1):
            self.C[k] = self.C[n - k]