from collections import deque

deg = [0]*N
for x in X:
    deg[x] += 1
visit = [-1]*N
deq = deque([i for i in range(N) if deg[i]==0])
while deq:
    v = deq.popleft()
    visit[v] = 1
    deg[X[v]] -= 1
    if deg[X[v]] == 0:
        deq.append(X[v])

# 入次数０の頂点を削除していくことでfunctional graphのサイクル部分だけを抜き出せる（visit=-1の頂点）