"""
mathlib.py - copy-paste friendly number theory utilities (ACL-like).

Includes:
- crt (Chinese Remainder Theorem)
- floor_sum (ACL floor_sum)
"""

from typing import List, Tuple

# ---------- GCD / inverse ----------

def _inv_gcd(a: int, b: int) -> Tuple[int, int]:
    """
    Returns (g, x) where:
      g = gcd(a, b)
      x is in [0, b/g) and satisfies a*x ≡ g (mod b)

    This is ACL-style inv_gcd; useful for crt and modular inverse.
    """
    a %= b
    if a == 0:
        return (b, 0)

    s, t = b, a
    m0, m1 = 0, 1
    while t:
        u = s // t
        s -= t * u
        m0 -= m1 * u
        s, t = t, s
        m0, m1 = m1, m0

    # s is gcd, m0 is the coefficient
    if m0 < 0:
        m0 += b // s
    return (s, m0)

# ---------- CRT ----------

def crt(r: List[int], m: List[int]) -> Tuple[int, int]:
    """
    Chinese Remainder Theorem for possibly non-coprime moduli.

    Solve:
      x ≡ r[i] (mod m[i])

    Returns (x0, lcm) s.t.
      x ≡ x0 (mod lcm)
    If no solution, returns (0, 0).
    """
    if len(r) != len(m):
        raise ValueError("r and m must have the same length")

    r0, m0 = 0, 1
    for (r1, m1) in zip(r, m):
        if m1 <= 0:
            raise ValueError("all moduli must be positive")
        r1 %= m1

        # ensure m0 >= m1 to keep numbers small
        if m0 < m1:
            r0, r1 = r1, r0
            m0, m1 = m1, m0

        if m0 % m1 == 0:
            if r0 % m1 != r1:
                return (0, 0)
            continue

        g, im = _inv_gcd(m0, m1)  # im = inv(m0/g) mod (m1/g)
        if (r1 - r0) % g != 0:
            return (0, 0)

        u1 = m1 // g
        x = ((r1 - r0) // g % u1) * im % u1

        r0 += x * m0
        m0 *= u1
        r0 %= m0

    return (r0, m0)


# ---------- floor_sum ----------

def floor_sum(n: int, m: int, a: int, b: int) -> int:
    """
    Computes sum_{0 <= i < n} floor((a*i + b) / m).

    Constraints:
      n >= 0, m >= 1
    """
    if n < 0:
        raise ValueError("n must be non-negative")
    if m <= 0:
        raise ValueError("m must be positive")
    if n == 0:
        return 0

    ans = 0

    if a >= m:
        ans += (n - 1) * n * (a // m) // 2
        a %= m
    if a < 0:
        # normalize negative a
        a %= m

    if b >= m:
        ans += n * (b // m)
        b %= m
    if b < 0:
        b %= m

    y_max = (a * n + b) // m
    x_max = y_max * m - b
    if y_max == 0:
        return ans

    ans += (n - (x_max + a - 1) // a) * y_max
    # recurse
    ans += floor_sum(y_max, a, m, (a - x_max % a) % a)
    return ans
