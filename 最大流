import collections


class mf_graph:
    n = 0
    g = []
    def __init__(self, n_):
        self.n = n_
        self.g = [[] for i in range(self.n)]
        self.pos = []

    class _edge:
        to = 0
        rev = 0
        cap = 0
        def __init__(self, to_, rev_, cap_):
            self.to = to_
            self.rev = rev_
            self.cap = cap_

    class edge:
        From = 0
        To = 0
        Cap = 0
        Flow = 0
        def __init__(self, from_, to_, cap_, flow_):
            self.From = from_
            self.To = to_
            self.Cap = cap_
            self.Flow = flow_

    def add_edge(self, From_, To_, Cap_):# 有向辺の追加（cap:最大の流量）
        """
        引数: From_（u）, To_（v）, Cap_（容量 ≥ 0）
        戻り値: 追加した順辺のインデックス（int）
        無向辺を貼りたい時は両側に辺を張る
        """
        assert 0 <= From_ and From_ < self.n
        assert 0 <= To_ and To_ < self.n
        assert 0 <= Cap_
        m = len(self.pos)
        self.pos.append((From_, len(self.g[From_])))
        from_id = len(self.g[From_])
        to_id = len(self.g[To_])
        if From_ == To_:
            to_id += 1
        self.g[From_].append(self._edge(To_, to_id, Cap_))
        self.g[To_].append(self._edge(From_, from_id, 0))
        return m

    def get_edge(self, i):# 戻り値: edge オブジェクト（または同等の構造体）From（u）, To（v）, Cap（元容量）, Flow（順辺に実際に流れた量）
        """
        引数: i（順辺インデックス）
        戻り値: edge オブジェクト（または同等の構造体）
        From（u）, To（v）, Cap（元容量）, Flow（順辺に実際に流れた量）
        """
        m = len(self.pos)
        assert 0 <= i and i < m
        _e = self.g[self.pos[i][0]][self.pos[i][1]]
        _re = self.g[_e.to][_e.rev]
        return self.edge(self.pos[i][0], _e.to, _e.cap + _re.cap, _re.cap)

    def edges(self, isdict=True):
        """
        引数: isdict（True なら辞書のリスト、False なら edge オブジェクトのリスト）
        戻り値: すべての順辺についての配列（[{from,to,cap,flow}, ...] もしくは edge の配列）
        役割: 可視化・デバッグ用に現在の順辺情報をまとめて取得。
        注意: cap は追加時の元容量を示し、flow が実際に流れた量。
        """
        m = len(self.pos)
        result = []
        for i in range(m):
            if isdict:
                e = self.get_edge(i)
                result.append(
                    {"from": e.From, "to": e.To, "cap": e.Cap, "flow": e.Flow}
                )
            else:
                result.append(self.get_edge(i))
        return result

    def change_edge(self, i, new_cap, new_flow):
        """
        引数: i（順辺インデックス）, new_cap（新しい元容量）, new_flow（新しい流量；0 ≤ flow ≤ cap）
        戻り値: なし
        役割: 既存の順辺 i の元容量と流量を上書き。残余グラフ側の容量も対応するように調整。
        注意: 一貫性チェックあり（0 ≤ new_flow ≤ new_cap）。
        グラフをリセットしたい時は、都度作り直す方が安全なことも多いです。
        """
        m = len(self.pos)
        assert 0 <= i and i < m
        assert 0 <= new_flow and new_flow <= new_cap
        _e = self.g[self.pos[i][0]][self.pos[i][1]]
        _re = self.g[_e.to][_e.rev]
        _e.cap = new_cap - new_flow
        _re.cap = new_flow
        assert id(_e) == id(self.g[self.pos[i][0]][self.pos[i][1]])
        assert id(_re) == id(self.g[_e.to][_e.rev])

    def flow(self, s, t, flow_limit=(1 << 63) - 1):
        """
        flow(self, s, t, flow_limit=(1 << 63) - 1)
        引数: s（ソース）, t（シンク）, flow_limit（上限:既定はほぼ∞）
        戻り値: 実際に流せた流量（int）
        """
        assert 0 <= s and s < self.n
        assert 0 <= t and t < self.n
        assert s != t
        level = [0 for i in range(self.n)]
        Iter = [0 for i in range(self.n)]
        que = collections.deque([])

        def bfs():
            for i in range(self.n):
                level[i] = -1
            level[s] = 0
            que.clear()
            que.append(s)
            while que:
                v = que.popleft()
                for e in self.g[v]:
                    if e.cap == 0 or level[e.to] >= 0:
                        continue
                    level[e.to] = level[v] + 1
                    if e.to == t:
                        return
                    que.append(e.to)

        def dfs(v, up):
            if v == s:
                return up
            res = 0
            level_v = level[v]
            for i in range(Iter[v], len(self.g[v])):
                e = self.g[v][i]
                assert id(e) == id(self.g[v][i])
                if level_v <= level[e.to] or self.g[e.to][e.rev].cap == 0:
                    continue
                d = dfs(e.to, min(up - res, self.g[e.to][e.rev].cap))
                if d <= 0:
                    continue
                self.g[v][i].cap += d
                self.g[e.to][e.rev].cap -= d
                res += d
                if res == up:
                    return res
            level[v] = self.n
            return res

        flow = 0
        while flow < flow_limit:
            bfs()
            if level[t] == -1:
                break
            Iter = [0 for i in range(self.n)]
            f = dfs(t, flow_limit - flow)
            if not (f):
                break
            flow += f
        return flow

    def min_cut(self, s):
        """
        引数: s（ソース）
        戻り値: visited（長さ n の bool 配列:True が s 側に残余到達可能）
        役割: 最小 s-カットの s 側頂点集合を返す（最大流計算後の残余グラフで到達可能な集合）。
        """
        visited = [False for i in range(self.n)]
        que = collections.deque([s])
        while que:
            p = que.popleft()
            visited[p] = True
            for e in self.g[p]:
                if e.cap and not (visited[e.to]):
                    visited[e.to] = True
                    que.append(e.to)
        return visited