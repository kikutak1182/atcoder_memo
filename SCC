import sys
class SCC:
    def __init__(self, n):
        self.n = n
        self.edges = []

    def add_edge(self, u, v):
        self.edges.append((u, v))

    def scc_ids(self):
        n = self.n
        edges = self.edges
        # CSR
        start = [0] * (n + 1)
        elist = [0] * len(edges)
        for u, v in edges:
            start[u + 1] += 1
        for i in range(1, n + 1):
            start[i] += start[i - 1]
        counter = start[:]
        for u, v in edges:
            elist[counter[u]] = v
            counter[u] += 1
        # Tarjan SCC
        now_ord = 0
        group_num = 0
        visited = []
        low = [0] * n
        order = [-1] * n
        ids = [0] * n

        sys.setrecursionlimit(max(10**6, n * 2 + 10))

        def dfs(v):
            nonlocal now_ord, group_num
            low[v] = order[v] = now_ord
            now_ord += 1
            visited.append(v)
            for i in range(start[v], start[v + 1]):
                to = elist[i]
                if order[to] == -1:
                    dfs(to)
                    low[v] = min(low[v], low[to])
                else:
                    low[v] = min(low[v], order[to])
            if low[v] == order[v]:
                while True:
                    u = visited.pop()
                    order[u] = n
                    ids[u] = group_num
                    if u == v:
                        break
                group_num += 1
        for v in range(n):
            if order[v] == -1:
                dfs(v)
        for v in range(n):
            ids[v] = group_num - 1 - ids[v]

        return group_num, ids

    def scc(self):
        group_num, ids = self.scc_ids()
        groups = [[] for _ in range(group_num)]
        for v in range(self.n):
            groups[ids[v]].append(v)

        return groups #