# MLEを避け、全要素持つより数倍高速

dp1 = [0]*(K+1)
dp2 = [0]*(K+1)
dp1[0] = 1
for i in range(N-1):
    dp2[:] = [0] * (K + 1)  # dp2自体は同じリストのまま、中身だけ置換（高速）
    for k in range(K+1):
        dp2[k] += dp1[k]
        dp2[k] %= mod
        if k+cnt[i]<=K:
            dp2[k+cnt[i]] += dp1[k]
            dp2[k+cnt[i]] %= mod
    dp1,dp2 = dp2,dp1 #ここが重:swapはO(1)

