# 素因数分解　O(√N) 
# n=1の時空配列を返す
def factorization(n):
    if n == 1: # これをなくすとn=1の時　[1, 1]　を返す
        return []  
    arr = []
    temp = n
    for i in range(2, int(-(-n**0.5//1))+1):
        if temp%i==0:
            cnt=0
            while temp%i==0:
                cnt+=1
                temp //= i
            arr.append([i, cnt])

    if temp!=1:
        arr.append([temp, 1])

    if arr==[]:
        arr.append([n, 1])

    return arr

print(factorization(24))
## [[2, 3], [3, 1]] 


